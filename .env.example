# Create an account at https://www.emailjs.com, add an email service and a
# template (with "name", "email", "message" variables matching the contact
# form fields), then copy the three IDs below into a local .env file.
# Without these, the contact form falls back to opening the visitor's email app.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
